#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# vifast-guard / commit-msg — KT-85b, thi hành D2-125.2 (phần nhãn commit) + AGENTS.md §7.
#
# Luật: dòng đầu (subject) của commit message **phải** mở đầu bằng nhãn task:
#
#     ^\[(KT|ST)-[0-9]+[a-z]?\]
#
#   Hợp lệ : "[KT-00] …", "[KT-77b] …", "[ST-165] …", "[KT-04a] …"
#   Không  : "sửa lỗi", "KT-85 …" (thiếu ngoặc), "[kt-85] …" (sai hoa), "[KT-] …"
#
# Vì sao cần: KT-85 chặn **ai** được commit (VIFAST_ROLE) nhưng không kiểm **nội dung**;
# một commit không nhãn làm mất đường truy vết task ⇔ journal ⇔ cổng, và đó là thứ review
# phải soi bằng mắt. Kiểm nhãn bằng máy thì không phải soi nữa.
#
# Miễn trừ (git tự sinh, KHÔNG có nhãn của người):
#   * "Merge …"      — merge commit (`Merge branch 'x' into y`, `Merge tag 'v1'`, …)
#   * Revert "…"     — `git revert` sinh message `Revert "[KT-xx] …"`
#   (hai dạng này được giữ nguyên để `git merge`/`git revert` của lead không bị chặn oan;
#   chúng vẫn chịu luật nhánh: reference-transaction đòi VIFAST_ROLE=lead cho refs/heads/main)
#
# Không miễn trừ: "fixup! …", "squash! …", "amend! …" — agent không dùng các dạng đó ở repo
# này; nếu cần, lead sửa message trước khi commit.
#
# Không chặn theo VIFAST_ROLE: việc "ai được commit" đã do pre-commit lo (fail-closed). Hook
# này chỉ nói về **nội dung**, nên nó chạy được cả khi pre-commit bị --no-verify bỏ qua…
# trừ khi chính --no-verify bỏ qua cả hook này (git bỏ qua toàn bộ pre-commit + commit-msg).
#
# Git truyền vào: $1 = đường dẫn tệp message (đã có message, có thể kèm dòng chú thích `#`).
#
# Bản gốc: v2/tools/git-guard/commit-msg — cài bằng v2/tools/git-guard/install.sh vào
# `<git-common-dir>/hooks/` nên áp cho mọi worktree.

set -u

doc_hint='v2/docs/k6-git-guard.md'
msg_file="${1-}"

# Không có tệp message ⇒ không có gì để kiểm; đừng chặn oan (git luôn truyền tham số này).
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    exit 0
fi

# ------------------------------------------------------------------ lấy subject
# Subject = dòng đầu tiên không rỗng và không phải dòng chú thích (`#`) — đúng như git
# "cleanup" làm trước khi ghi commit. Đọc bằng shell thuần để không phụ thuộc awk/sed lạ.
subject=''
# `read` trả khác 0 ở EOF **kể cả** khi dòng cuối không có newline (tệp message do người
# soạn có thể như vậy) — vẫn phải xử lý dòng đó, nếu không hook sẽ "cho qua" im lặng.
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        '#'*) continue ;;
    esac
    trimmed=$(printf '%s' "$line" | tr -d ' \t\r')
    if [ -z "$trimmed" ]; then
        continue
    fi
    subject="$line"
    break
done <"$msg_file"

# Message rỗng (chỉ có chú thích): git sẽ tự huỷ commit (trừ --allow-empty-message).
# Không chặn ở đây để không đổi hành vi mặc định của git.
if [ -z "$subject" ]; then
    exit 0
fi

# ------------------------------------------------------------------ miễn trừ message tự sinh
case "$subject" in
    'Merge '* | 'Revert "'*)
        printf 'vifast-guard(commit-msg): CHO QUA — message tự sinh của git (%s), không cần nhãn (KT-85b)\n' \
            "$subject" >&2
        exit 0
        ;;
esac

# ------------------------------------------------------------------ kiểm nhãn
label_ok=0
if printf '%s' "$subject" |
    grep -Eq '^\[(KT|ST)-[0-9]+[a-z]?\]'; then
    label_ok=1
fi

if [ "$label_ok" -eq 1 ]; then
    printf 'vifast-guard(commit-msg): CHO QUA — subject có nhãn task: %s\n' "$subject" >&2
    exit 0
fi

# ------------------------------------------------------------------ từ chối
name=$(git config user.name 2>/dev/null || true)
mail=$(git config user.email 2>/dev/null || true)
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
top=$(git rev-parse --show-toplevel 2>/dev/null || true)
[ -n "$name" ] || name='(chưa cấu hình user.name)'
[ -n "$mail" ] || mail='(chưa cấu hình user.email)'
[ -n "$branch" ] || branch='(không xác định / detached HEAD)'
[ -n "$top" ] || top='(không xác định)'

{
    printf '\n'
    printf 'vifast-guard(commit-msg): TỪ CHỐI COMMIT — thiếu nhãn task (KT-85b / D2-125.2)\n'
    printf '  Subject hiện tại: %s\n' "$subject"
    printf '  Cần khớp       : ^\\[(KT|ST)-[0-9]+[a-z]?\\]  (nhãn ở NGAY ĐẦU dòng, có ngoặc vuông)\n'
    printf '  Ví dụ đúng     : [KT-00] tóm tắt việc đã làm\n'
    printf '                   [KT-77b] sửa hook chặn nhánh chính\n'
    printf '                   [ST-165] lexer theo SPEC-lex\n'
    printf '  Người commit   : %s <%s>\n' "$name" "$mail"
    printf '  Nhánh          : %s\n' "$branch"
    printf '  Nơi commit     : %s\n' "$top"
    printf '\n'
    printf '  Miễn trừ       : "Merge …" (merge commit) và Revert \"…\" (git revert) — hai dạng\n'
    printf '                   git tự sinh, không cần nhãn của người.\n'
    printf '  Sửa thế nào    : đặt lại message có nhãn đúng task trong QUEUE.md (AGENTS.md §7),\n'
    printf '                   ví dụ: git commit -m "[KT-85b] hook reference-transaction"\n'
    printf '                   (không dùng --no-verify: đó là quyền của người, không phải của agent)\n'
    printf '\n'
    printf '  Tài liệu: %s · cài/kiểm: v2/tools/git-guard/install.sh --check\n' "$doc_hint"
    printf '  vifast-guard: RESULT=DENY hook=commit-msg\n'
    printf '\n'
} >&2

exit 1
