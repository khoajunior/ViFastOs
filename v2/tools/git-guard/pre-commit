#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# vifast-guard / pre-commit — KT-85, thi hành D2-123 mục (4)(b) + (d).
#
# Chặn commit **bằng máy**: CHỈ vai "lead" (Agent 1) được commit.
#   * Nguồn vai DUY NHẤT: biến môi trường VIFAST_ROLE. Hook **không** tự đặt biến,
#     **không** đọc .git/config, **không** đọc tệp cấu hình nào (không có đường sửa
#     bằng tay rồi commit như lead).
#   * Fail-closed: chưa đặt / rỗng / bất kỳ giá trị khác "lead" (kể cả "Lead", "lead ")
#     ⇒ TỪ CHỐI (mã thoát khác 0, git huỷ commit).
#   * VIFAST_ROLE=lead ⇒ CHO QUA (in đúng một dòng để log cổng/commit có dấu vết).
#
# Quyền của **người** (không phải agent): `git commit --no-verify` bỏ qua hook — hook
# không chặn, không thể chặn, và đó là chủ ý (xem v2/docs/k6-git-guard.md §4).
#
# Bản gốc của tệp này nằm trong repo (`v2/tools/git-guard/pre-commit`); bản đang chạy
# được cài vào `<git-common-dir>/hooks/pre-commit` bằng `v2/tools/git-guard/install.sh`.
# Hook cài ở common dir nên áp cho **mọi** worktree của repo (đó là điều ta cần: agent
# làm trong worktree riêng vẫn bị chặn).

set -u

doc_hint='v2/docs/k6-git-guard.md'
role="${VIFAST_ROLE-}"

# ---------------------------------------------------------------- cho qua: lead
if [ "$role" = "lead" ]; then
    printf 'vifast-guard(pre-commit): CHO QUA — VIFAST_ROLE=lead (KT-85 / D2-123.4)\n' >&2
    exit 0
fi

# ---------------------------------------------------------------- từ chối (fail-closed)
if [ -z "$role" ]; then
    ly_do='chưa đặt VIFAST_ROLE (không có trong môi trường / rỗng) ⇒ fail-closed'
    role_in='(chưa đặt)'
else
    ly_do="VIFAST_ROLE=\"$role\" khác \"lead\""
    role_in="\"$role\""
fi

# Chẩn đoán: ai đang commit, ở đâu. Mọi lệnh git đều có fallback — hook không được
# chết vì một lệnh phụ lỗi (chết im lặng = dễ bị hiểu là "cho qua").
name=$(git config user.name 2>/dev/null || true)
mail=$(git config user.email 2>/dev/null || true)
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
top=$(git rev-parse --show-toplevel 2>/dev/null || true)
abs_git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null || true)
common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
if [ -z "$common_dir" ]; then
    # git cũ không hỗ trợ --path-format: tự tuyệt đối hoá.
    common_dir=$(git rev-parse --git-common-dir 2>/dev/null || true)
    case "$common_dir" in
        /*) ;;
        '') ;;
        *) common_dir="$top/$common_dir" ;;
    esac
fi
if [ -z "$abs_git_dir" ]; then
    abs_git_dir=$(git rev-parse --git-dir 2>/dev/null || true)
    case "$abs_git_dir" in
        /*) ;;
        '') ;;
        *) abs_git_dir="$top/$abs_git_dir" ;;
    esac
fi

[ -n "$name" ] || name='(chưa cấu hình user.name)'
[ -n "$mail" ] || mail='(chưa cấu hình user.email)'
[ -n "$branch" ] || branch='(không xác định)'
[ -n "$top" ] || top='(không xác định)'
loai='không xác định'
if [ -n "$abs_git_dir" ] && [ -n "$common_dir" ]; then
    if [ "$abs_git_dir" = "$common_dir" ]; then
        loai='checkout chính'
    else
        loai='worktree liên kết'
    fi
fi

{
    printf '\n'
    printf 'vifast-guard(pre-commit): TỪ CHỐI COMMIT — KT-85 / D2-123 mục (4)(b),(d)\n'
    printf '  Lý do      : %s\n' "$ly_do"
    printf '  Vai hiện tại: VIFAST_ROLE=%s\n' "$role_in"
    printf '  Người commit: %s <%s>\n' "$name" "$mail"
    printf '  Nhánh       : %s\n' "$branch"
    printf '  Nơi commit  : %s (%s)\n' "$top" "$loai"
    printf '  Hook        : %s\n' "$0"
    printf '\n'
    printf '  Vì sao: A1-177 (index dùng chung bị nhiễm chéo dòng) và A1-180 (agent tự\n'
    printf '  commit làm HEAD đỏ) — lần vi phạm thứ hai ⇒ chặn bằng cấu trúc, không nhắc\n'
    printf '  bằng lời. Chỉ Agent 1 (lead) đặt được VIFAST_ROLE.\n'
    printf '\n'
    printf '  Phải làm gì:\n'
    printf '   1) Agent (Agent 2 / reviewer) — KHÔNG commit ở checkout chính. Tạo worktree\n'
    printf '      riêng cho task, làm ở đó, rồi báo lead:\n'
    printf '          git worktree add ../wt-<mã> -b task/<mã>\n'
    printf '      (mọi tệp sửa nằm trong worktree đó; index của checkout chính không bị\n'
    printf '      chạm — đây chính là chỗ vá A1-177.)\n'
    printf '   2) Lead (Agent 1) — đặt biến rồi commit trong đúng worktree của task:\n'
    printf '          VIFAST_ROLE=lead git -C ../wt-<mã> commit ...\n'
    printf '      rồi merge/cherry-pick sang nhánh chính.\n'
    printf '   3) Người thật — `git commit --no-verify` bỏ qua hook: quyền của người, hook\n'
    printf '      không có đường tự bỏ qua và không được phép chặn.\n'
    printf '\n'
    printf '  Tài liệu: %s · cài/kiểm: v2/tools/git-guard/install.sh --check\n' "$doc_hint"
    printf '  vifast-guard: RESULT=DENY hook=pre-commit role=%s\n' "$role_in"
    printf '\n'
} >&2

exit 1
