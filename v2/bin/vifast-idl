#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# `vifast-idl gen` sinh stub từ `.vidl`; `vifast-idl --check` là gen-check IDL của cổng (KT-69).
set -u
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
PY=""
for c in python3.12 python3.11 python3; do command -v "$c" >/dev/null 2>&1 && { PY="$c"; break; }; done
[ -n "$PY" ] || { echo "vifast-idl: không thấy python3.11+" >&2; exit 1; }
exec "$PY" "$ROOT/v2/tools/vifast-gen/gen_idl.py" --root "$ROOT" "$@"
